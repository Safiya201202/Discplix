# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# The email that gets moderator rights (can delete anyone's community chat message)
OWNER_EMAIL=you@example.com
